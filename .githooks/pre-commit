#!/usr/bin/env bash
#
# pre-commit — block commits that contain secrets (API keys, tokens, etc.).
# Enabled by install.sh via `git config core.hooksPath .githooks`.

set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed. Run: brew install gitleaks" >&2
  exit 1
fi

if ! gitleaks git --pre-commit --staged --redact --no-banner --verbose; then
  echo "" >&2
  echo "pre-commit: possible secret found in staged changes; commit blocked." >&2
  echo "Move it to ~/.zshrc.local (untracked). For a false positive, add a" >&2
  echo "'gitleaks:allow' comment on that line." >&2
  exit 1
fi
